set system host-name P5
set routing-options router-id 10.255.0.5
set interfaces lo0 unit 0 description "P ROUTER-ID"
set interfaces lo0 unit 0 family inet address 10.255.0.5/32
set interfaces lo0 unit 0 family inet6 address 2001:db8:500:abcd::5/128
set interfaces lo0 unit 0 family iso address 49.0001.0000.0000.0005.00
set protocols isis level 1 disable
set protocols isis level 2 wide-metrics-only
set protocols isis topologies ipv6-unicast
set protocols isis interface lo0.0 passive
set interfaces ge-0/0/1 description "CORE-RING -> P4"
