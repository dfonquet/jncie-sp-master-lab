set system host-name RR2
set system services ssh
set system services netconf ssh
set routing-options router-id 10.255.0.22
set interfaces lo0 unit 0 description "RR ROUTER-ID"
set interfaces lo0 unit 0 family inet address 10.255.0.22/32
set interfaces lo0 unit 0 family inet6 address 2001:db8:500:abcd::22/128
set interfaces lo0 unit 0 family iso address 49.0001.0000.0000.0022.00
set protocols isis level 1 disable
set protocols isis level 2 wide-metrics-only
set protocols isis topologies ipv6-unicast
set protocols isis interface lo0.0 passive
set interfaces ge-0/0/1 description "RR-UPLINK -> P2"
set interfaces ge-0/0/1 unit 0 family inet address 10.0.12.0/31
set interfaces ge-0/0/1 unit 0 family inet6 address 2001:db8:1000:12::/127
set interfaces ge-0/0/1 unit 0 family iso
set protocols isis interface ge-0/0/1.0 point-to-point
set protocols isis interface ge-0/0/1.0 level 2 metric 10
set protocols isis interface ge-0/0/1.0 level 2 ipv6-unicast metric 10
set interfaces ge-0/0/2 description "RR-UPLINK -> P3"
set interfaces ge-0/0/2 unit 0 family inet address 10.0.13.0/31
set interfaces ge-0/0/2 unit 0 family inet6 address 2001:db8:1000:13::/127
set interfaces ge-0/0/2 unit 0 family iso
set protocols isis interface ge-0/0/2.0 point-to-point
set protocols isis interface ge-0/0/2.0 level 2 metric 10
set protocols isis interface ge-0/0/2.0 level 2 ipv6-unicast metric 10
