set system host-name PE1
set routing-options router-id 10.255.0.11
set interfaces lo0 unit 0 description "PE ROUTER-ID"
set interfaces lo0 unit 0 family inet address 10.255.0.11/32
set interfaces lo0 unit 0 family inet6 address 2001:db8:500:abcd::11/128
set interfaces lo0 unit 0 family iso address 49.0001.0000.0000.0011.00
set protocols isis level 1 disable
set protocols isis level 2 wide-metrics-only
set protocols isis topologies ipv6-unicast
set protocols isis interface lo0.0 passive
set interfaces ge-0/0/1 description "PE-UPLINK -> P1"
set interfaces ge-0/0/1 unit 0 family inet address 10.0.7.0/31
set interfaces ge-0/0/1 unit 0 family inet6 address 2001:db8:1000:7::/127
set interfaces ge-0/0/1 unit 0 family iso
set protocols isis interface ge-0/0/1.0 point-to-point
set protocols isis interface ge-0/0/1.0 level 2 metric 10
set protocols isis interface ge-0/0/1.0 level 2 ipv6-unicast metric 10
set interfaces ge-0/0/2 description "PE-UPLINK -> P2"
set interfaces ge-0/0/2 unit 0 family inet address 10.0.8.0/31
set interfaces ge-0/0/2 unit 0 family inet6 address 2001:db8:1000:8::/127
set interfaces ge-0/0/2 unit 0 family iso
set protocols isis interface ge-0/0/2.0 point-to-point
set protocols isis interface ge-0/0/2.0 level 2 metric 10
set protocols isis interface ge-0/0/2.0 level 2 ipv6-unicast metric 10
